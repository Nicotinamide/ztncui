//-
  ztncui - ZeroTier network controller UI
  Modern IP Assignment Pools View

extends network_layout

block net_content
  .modern-card
    .modern-card-header
      div
        h3= t('pools.title')
        p.modern-card-subtitle= t('pools.subtitle')

    if network.ipAssignmentPools && network.ipAssignmentPools.length > 0
      .table-responsive
        table.table.table-hover
          thead
            tr
              th(style='width: 5%;')
              th(style='width: 45%;')= t('pools.range_start')
              th(style='width: 50%;')= t('pools.range_end')
          tbody
            each ipAssignmentPool in network.ipAssignmentPools
              tr
                td
                  a(href='/controller/network/' + network.nwid + '/ipAssignmentPools/' + ipAssignmentPool.ipRangeStart + '/' + ipAssignmentPool.ipRangeEnd + '/delete' title=t('common.delete') style='color: var(--danger);' onclick="return confirm('" + t('common.confirm') + " " + t('common.delete') + "?')")
                    span.glyphicon.glyphicon-trash
                td
                  span.badge-ip(style='font-size: 13px;')= ipAssignmentPool.ipRangeStart
                td
                  span.badge-ip(style='font-size: 13px;')= ipAssignmentPool.ipRangeEnd
    else
      .text-center(style='padding: 24px; background: #f8fafc; border-radius: 8px; margin-bottom: 20px;')
        p(style='color: var(--text-muted); margin: 0;')= t('pools.empty')

    .modern-card(style='background: #f8fafc; border: 1px solid var(--border); margin-top: 24px; margin-bottom: 0;')
      h4(style='font-size: 16px; font-weight: 700; margin-top: 0; margin-bottom: 16px;')= t('pools.add_btn')

      if errors
        .alert.alert-warning(style='border-radius: 8px;')
          ul(style='margin: 0; padding-left: 20px;')
            for err in errors
              li!= err.msg

      form(method='POST' action='/controller/network/' + network.nwid + '/ipAssignmentPools')
        .row
          .col-sm-6
            .form-group
              label(for='ipRangeStart')= t('pools.range_start')
              input#ipRangeStart.form-control(type='text' name='ipRangeStart' placeholder='e.g. 10.147.17.1' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeStart) required)
          .col-sm-6
            .form-group
              label(for='ipRangeEnd')= t('pools.range_end')
              input#ipRangeEnd.form-control(type='text' name='ipRangeEnd' placeholder='e.g. 10.147.17.254' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeEnd) required)

        div(style='margin-top: 16px; display: flex; gap: 10px;')
          button.btn.btn-primary(type='submit')
            span.glyphicon.glyphicon-plus(style='margin-right: 4px;')
            | #{t('pools.add_btn')}
          a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.cancel')
