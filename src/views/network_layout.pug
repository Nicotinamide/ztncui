//-
  ztncui - ZeroTier network controller UI
  Modern Network Layout

extends controller_layout

block content
  if error
    .alert.alert-danger(style='border-radius: 8px;')
      strong ❌ #{error}
  else
    - const nwurl = '/controller/network/' + network.nwid;
    .modern-card(style='margin-bottom: 20px;')
      .modern-card-header(style='border-bottom: none; margin-bottom: 0; padding-bottom: 0;')
        div(style='flex: 1;')
          div(style='display: flex; align-items: center; gap: 12px; flex-wrap: wrap;')
            block network_title
              h2(style='margin: 0; font-size: 22px; font-weight: 700;')
                span#name= network.name || 'Network'
            
            div(style='display: flex; align-items: center; gap: 6px;')
              span.badge-id= network.nwid
              button.copy-btn(type='button' onclick="copyToClipboard('" + network.nwid + "', '" + t('common.copied') + "')" title=t('common.copy'))
                span.glyphicon.glyphicon-copy

            if network.private
              a(href=nwurl + '/private' style='text-decoration: none;' title=t('network_detail.switch_to_public'))
                span.badge-pill-mode.mode-private 🔒 #{t('network_detail.private_mode')}
            else
              a(href=nwurl + '/private' style='text-decoration: none;' title=t('network_detail.switch_to_private'))
                span.badge-pill-mode.mode-public 🌐 #{t('network_detail.public_mode')}

        div
          a.btn.btn-default(href=(navigate.whence || '/controller/networks'))
            span.glyphicon.glyphicon-arrow-left(style='margin-right: 4px;')
            | #{t('common.back')}

      div.network-subnav(style='margin-top: 18px; margin-bottom: 0;')
        a.btn.btn-default(href=nwurl class=(title && title.indexOf('Detail') !== -1 ? 'active' : ''))
          span.glyphicon.glyphicon-th-list(style='margin-right: 4px;')
          | #{t('network_detail.tab_overview')}
        a.btn.btn-default(href=nwurl + '/easy' class=(title && title.indexOf('Easy') !== -1 ? 'active' : ''))
          span.glyphicon.glyphicon-wrench(style='margin-right: 4px;')
          | #{t('network_detail.tab_easy_setup')}
        a.btn.btn-default(href=nwurl + '/routes' class=(title && title.indexOf('routes') !== -1 ? 'active' : ''))
          span.glyphicon.glyphicon-random(style='margin-right: 4px;')
          | #{t('network_detail.tab_routes')}
        a.btn.btn-default(href=nwurl + '/ipAssignmentPools' class=(title && title.indexOf('ipAssignmentPools') !== -1 ? 'active' : ''))
          span.glyphicon.glyphicon-tasks(style='margin-right: 4px;')
          | #{t('network_detail.tab_pools')}
        a.btn.btn-default(href=nwurl + '/v4AssignMode' class=(title && title.indexOf('AssignMode') !== -1 ? 'active' : ''))
          span.glyphicon.glyphicon-cog(style='margin-right: 4px;')
          | #{t('network_detail.tab_assign_mode')}
        a.btn.btn-default(href=nwurl + '/dns' class=(title && title.indexOf('dns') !== -1 ? 'active' : ''))
          span.glyphicon.glyphicon-globe(style='margin-right: 4px;')
          | #{t('network_detail.tab_dns')}
        a.btn.btn-default(href=nwurl + '/delete' style='color: var(--danger);' onclick="return confirm('" + t('networks.delete_confirm') + "')")
          span.glyphicon.glyphicon-trash(style='margin-right: 4px;')
          | #{t('network_detail.tab_delete')}

    block net_content
