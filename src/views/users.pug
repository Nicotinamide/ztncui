//-
  ztncui - ZeroTier network controller UI
  Modern Users Management View

extends users_layout

block users_content
  .modern-card
    .modern-card-header
      div
        h2= t('users.title')
        p.modern-card-subtitle= t('users.subtitle')
      div
        a.btn.btn-primary(href='/users/create')
          span.glyphicon.glyphicon-plus(style='margin-right: 6px;')
          | #{t('users.add_user')}

    if users && Object.keys(users).length > 0
      .table-responsive
        table.table.table-hover
          thead
            tr
              th(style='width: 5%;')
              th(style='width: 40%;')= t('users.username')
              th(style='width: 35%;')= t('common.status')
              th(style='width: 20%; text-align: right;')= t('common.action')
          tbody
            each user in users
              tr
                td
                  a(href='/users/' + user.name + '/delete' title=t('common.delete') style='color: var(--danger);' onclick="return confirm('" + t('users.delete_confirm') + "')")
                    span.glyphicon.glyphicon-trash
                td
                  div(style='display: flex; align-items: center; gap: 8px;')
                    span.glyphicon.glyphicon-user(style='color: var(--primary);')
                    strong(style='font-size: 15px;')= user.name
                td
                  if user.pass_set
                    span.badge(style='background: var(--success-light); color: var(--success); border: 1px solid #a7f3d0; padding: 4px 8px;')
                      | 密码已配置
                  else
                    span.badge(style='background: var(--warning-light); color: var(--warning); border: 1px solid #fde68a; padding: 4px 8px;')
                      | 未设置密码
                td(style='text-align: right;')
                  a.btn.btn-default.btn-sm(href='/users/' + user.name + '/password')
                    span.glyphicon.glyphicon-lock(style='margin-right: 4px;')
                    | 修改密码
    else
      .text-center(style='padding: 36px; background: #f8fafc; border-radius: 8px;')
        p(style='color: var(--text-muted); margin: 0;') 暂无管理员账户
