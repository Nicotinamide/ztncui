//-
  ztncui - ZeroTier network controller UI
  Modern Password Setup View

extends users_layout

block users_content
  .modern-card(style='max-width: 600px; margin: 0 auto;')
    .modern-card-header
      div
        h3 设置管理员密码
        p.modern-card-subtitle 配置用户账户密码及安全登录策略
      div
        a.btn.btn-default(href='/users')= t('common.cancel')

    if message
      .alert.alert-info(style='border-radius: 8px;')
        strong ℹ️ #{message}

    if errors
      .alert.alert-warning(style='border-radius: 8px;')
        ul(style='margin: 0; padding-left: 20px;')
          for err in errors
            li!= err.msg

    form(method='POST' action='' style='margin-top: 20px;')
      .form-group
        label(for='username') 用户名:
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-user
          input#username.form-control(type='text' name='username' value=user.name readonly=readonly)

      .form-group(style='margin-top: 16px;')
        label(for='password1') 新密码 (至少 10 位):
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-lock
          input#password1.form-control(type='password' name='password1' placeholder='请输入新密码' value=(undefined===user.password1? '' : user.password1) required)

      .form-group(style='margin-top: 16px;')
        label(for='password2') 确认新密码:
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-lock
          input#password2.form-control(type='password' name='password2' placeholder='请再次输入新密码' value=(undefined===user.password2? '' : user.password2) required)

      .form-group(style='margin-top: 16px;')
        div(style='display: flex; align-items: center; gap: 8px;')
          input#pass_set(type='checkbox' name='pass_set' value='check' style='transform: scale(1.2);')
          label(for='pass_set' style='margin: 0; font-weight: normal; cursor: pointer;')
            | 强制该用户在下次登录时修改密码

      div(style='margin-top: 24px; display: flex; gap: 12px;')
        button.btn.btn-primary(type='submit')
          span.glyphicon.glyphicon-floppy-disk(style='margin-right: 4px;')
          | #{t('common.save')}
        a.btn.btn-default(href='/users')= t('common.cancel')
