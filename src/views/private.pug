//-
  ztncui - ZeroTier network controller UI
  Modern Private/Public Access Control View

extends network_layout

block net_content
  script.
    $(function() {
      $('#privateSwitch').on('change', function() {
        const isPrivate = this.checked;
        $.post('', {'private': isPrivate})
          .done(function() {
            if (window.showToast) {
              window.showToast(isPrivate ? '已切换为私有网络 (需手动授权)' : '已切换为公有网络 (自动允许加入)');
            }
          })
          .fail(function() {
            if (window.showToast) window.showToast('更新模式失败', 'error');
          });
      });
    });

  .modern-card
    .modern-card-header
      div
        h3 访问控制模式 (Access Control Mode)
        p.modern-card-subtitle 配置虚拟网络的加入与授权策略
      div
        a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.back')

    div(style='display: flex; align-items: center; justify-content: space-between; padding: 20px; background: #f8fafc; border-radius: 10px; border: 1px solid var(--border);')
      div
        h4(style='margin: 0 0 6px 0; font-weight: 700;')
          | 开启私有访问控制 (Private Network)
        p(style='margin: 0; color: var(--text-muted); font-size: 13px; max-width: 500px;')
          | 开启后，新设备加入网络必须由管理员在后台手动勾选“已授权”才可互相通信；关闭后为公有网络，任何知道网络 ID 的设备均可直接加入并获取 IP。
      div
        label.switch-box(style='transform: scale(1.2);')
          input#privateSwitch(type='checkbox' checked=(network.private ? true : false))
          span.slider
