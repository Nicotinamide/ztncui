//-
  ztncui - ZeroTier network controller UI
  Modern DNS Configuration View

extends network_layout

block net_content
  - const dns = network.dns || {};

  .modern-card
    .modern-card-header
      div
        h3 DNS 配置 (DNS Configuration)
        p.modern-card-subtitle 配置客户端连接到此网络时下发的内部域名与 DNS 服务器
      div
        a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.back')

    if (!dns.domain && !(dns.servers && dns.servers.length > 0))
      .alert.alert-info(style='border-radius: 8px;')
        strong ℹ️ 当前网络尚未启用自定义 DNS 配置。客户端将使用各设备的默认系统 DNS。
    else
      .row(style='margin-bottom: 20px;')
        .col-sm-6
          .modern-card(style='background: #f8fafc; border: 1px solid var(--border); margin-bottom: 0;')
            h5(style='margin: 0 0 6px 0; color: var(--text-muted); font-size: 13px;') 内部搜索域名 (Search Domain)
            span.badge-id(style='font-size: 14px;')= dns.domain || '(未配置)'
        .col-sm-6
          .modern-card(style='background: #f8fafc; border: 1px solid var(--border); margin-bottom: 0;')
            h5(style='margin: 0 0 6px 0; color: var(--text-muted); font-size: 13px;') DNS 服务器地址 (DNS Servers)
            if dns.servers && dns.servers.length > 0
              each server in dns.servers
                span.badge-ip(style='font-size: 13px;')= server
            else
              span(style='color: var(--text-muted);') (未配置)

    .modern-card(style='background: #f8fafc; border: 1px solid var(--border); margin-top: 24px; margin-bottom: 0;')
      h4(style='font-size: 16px; font-weight: 700; margin-top: 0; margin-bottom: 16px;') 修改 DNS 规则

      if errors
        .alert.alert-warning(style='border-radius: 8px;')
          ul(style='margin: 0; padding-left: 20px;')
            for err in errors
              li!= err.msg

      form(method='POST' action='')
        .form-group
          label(for='domain') 内部搜索域名 (Search Domain):
          input#domain.form-control(type='text' name='domain' placeholder='例如: corp.internal 或 mylan.test' value=dns.domain)

        .form-group
          label(for='servers') DNS 服务器 IP 地址 (一行一个):
          textarea#servers.form-control(name='servers' rows='3' placeholder='例如: 10.147.17.1 (每行一个有效 IP)')
            = !dns.servers ? '' : dns.servers.join('\n')

        div(style='margin-top: 20px; display: flex; gap: 10px;')
          button.btn.btn-primary(type='submit')
            span.glyphicon.glyphicon-floppy-disk(style='margin-right: 4px;')
            | #{t('common.save')}
          a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.cancel')
