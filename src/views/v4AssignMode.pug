extends network_layout

block net_content
  .modern-card
    .modern-card-header
      h3= t('network_detail.tab_assign_mode') + ' (IPv4)'
      p.modern-card-subtitle IPv4 Address Assignment Mode
    script.
      $(function() {
        $('#v4AssignModeCheckBox').on('change', function() {
          $.post('', {'zt': $(this).is(':checked')})
            .done(function() {
              if (window.showToast) window.showToast('IPv4 assign mode updated');
            });
        });
      });

    div(style='display: flex; align-items: center; gap: 12px; padding: 16px 0;')
      label.switch-box
        input#v4AssignModeCheckBox(type='checkbox' checked=(network.v4AssignMode && network.v4AssignMode.zt ? true : false))
        span.slider
      span(style='font-weight: 500; font-size: 15px;') Auto-assign from IP Assignment Pool

  if errors
    ul
      for err in errors
        li!= err.msg
