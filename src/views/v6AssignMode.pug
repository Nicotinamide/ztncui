extends network_layout

block net_content
  .modern-card
    .modern-card-header
      h3= t('network_detail.tab_assign_mode') + ' (IPv6)'
      p.modern-card-subtitle IPv6 Address Assignment Mode
    script.
      $(function() {
        $('.v6-switch').on('change', function() {
          $.post('', {
            '6plane': $('#6planeCheckBox').is(':checked'),
            'rfc4193': $('#rfc4193CheckBox').is(':checked'),
            'zt': $('#ztCheckBox').is(':checked')
          }).done(function() {
            if (window.showToast) window.showToast('IPv6 assign mode updated');
          });
        });
      });

    div(style='display: flex; flex-direction: column; gap: 16px; padding: 16px 0;')
      div(style='display: flex; align-items: center; gap: 12px;')
        label.switch-box
          input#6planeCheckBox.v6-switch(type='checkbox' checked=(network.v6AssignMode && network.v6AssignMode['6plane'] ? true : false))
          span.slider
        span(style='font-weight: 500;') ZT 6plane (/80 routable for each device)

      div(style='display: flex; align-items: center; gap: 12px;')
        label.switch-box
          input#rfc4193CheckBox.v6-switch(type='checkbox' checked=(network.v6AssignMode && network.v6AssignMode['rfc4193'] ? true : false))
          span.slider
        span(style='font-weight: 500;') ZT rfc4193 (/128 for each device)

      div(style='display: flex; align-items: center; gap: 12px;')
        label.switch-box
          input#ztCheckBox.v6-switch(type='checkbox' checked=(network.v6AssignMode && network.v6AssignMode['zt'] ? true : false))
          span.slider
        span(style='font-weight: 500;') Auto-assign from IP Assignment Pool

  if errors
    ul
      for err in errors
        li!= err.msg
