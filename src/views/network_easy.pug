//-
  ztncui - ZeroTier network controller UI
  Modern Easy Setup Wizard View

extends network_layout

block net_content
  script.
    function randomOctet() {
      return Math.floor(Math.random() * 254) + 1;
    }

    function randomIPv4() {
      const CIDR = '10.' + randomOctet() + '.' + randomOctet() + '.0/24';
      setSubnet(CIDR);
    }

    function setSubnet(CIDR) {
      document.getElementById('networkCIDR').value = CIDR;
      CIDRtoPool(CIDR);
    }

    function int32toIPv4String(int32) {
      let ipv4 = '';
      ipv4 = ((int32 & 0xff000000)>>>24).toString();
      ipv4 += '.' + ((int32 & 0x00ff0000)>>>16).toString();
      ipv4 += '.' + ((int32 & 0x0000ff00)>>>8).toString();
      ipv4 += '.' + (int32 & 0x000000ff).toString();
      return ipv4;
    }

    function CIDRtoPool(CIDR) {
      const parts = CIDR.split('/');
      const start = parts[0];
      const prefix = parts[1];
      if (undefined !== start && undefined !== prefix &&
       prefix > 0 && prefix < 33 &&
       /^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(start)
      ){
        const host32 = ((1 << (32 - parseInt(prefix))) - 1) >>> 0;
        const net = start.split('.').map(oct => {return parseInt(oct)});
        let net32 = 0 >>> 0;
        net32 = (net[0]<<24) + (net[1]<<16) + (net[2]<<8) + (net[3]);
        net32 &= ~host32;
        const bcast32 = net32 + host32;
        document.getElementById('networkCIDR').value = int32toIPv4String(net32) + '/' + prefix;
        document.getElementById('poolStart').value = int32toIPv4String(net32 + 1);  
        document.getElementById('poolEnd').value = int32toIPv4String(bcast32 - 1);
      }
    }

  .modern-card
    .modern-card-header
      div
        h3= t('easy_setup.title')
        p.modern-card-subtitle= t('easy_setup.subtitle')
      div
        a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.cancel')

    if message
      .alert.alert-success(style='border-radius: 8px;')
        strong ✅ #{message}

    if errors
      .alert.alert-warning(style='border-radius: 8px;')
        ul(style='margin: 0; padding-left: 20px;')
          for err in errors
            li!= err.msg

    div(style='background: #f8fafc; padding: 16px; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 24px;')
      label(style='font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 8px;')= t('easy_setup.preset_subnet')
      div(style='display: flex; gap: 8px; flex-wrap: wrap;')
        button.btn.btn-default.btn-sm(type='button' onclick="setSubnet('10.147.17.0/24')") 10.147.17.0/24 (推荐)
        button.btn.btn-default.btn-sm(type='button' onclick="setSubnet('192.168.192.0/24')") 192.168.192.0/24
        button.btn.btn-default.btn-sm(type='button' onclick="setSubnet('172.28.28.0/24')") 172.28.28.0/24
        button.btn.btn-primary.btn-sm(type='button' onclick='randomIPv4()')
          span.glyphicon.glyphicon-random(style='margin-right: 4px;')
          | 🎲 随机生成私网网段

    form(method='POST' action='')
      .form-group
        label(for='networkCIDR') 1. 目标虚拟局域网网段 (CIDR)
        input#networkCIDR.form-control(type='text' name='networkCIDR' onchange='CIDRtoPool(this.value)' placeholder='e.g. 10.147.17.0/24' value=(undefined===network.routes[0]? '' : network.routes[0].target) required)

      .row
        .col-sm-6
          .form-group
            label(for='poolStart') 2. IP 自动分配池起始地址 (Start IP)
            input#poolStart.form-control(type='text' name='poolStart' placeholder='e.g. 10.147.17.1' value=(undefined===network.ipAssignmentPools[0]? '' : network.ipAssignmentPools[0].ipRangeStart) required)
        .col-sm-6
          .form-group
            label(for='poolEnd') 3. IP 自动分配池结束地址 (End IP)
            input#poolEnd.form-control(type='text' name='poolEnd' placeholder='e.g. 10.147.17.254' value=(undefined===network.ipAssignmentPools[0]? '' : network.ipAssignmentPools[0].ipRangeEnd) required)

      div(style='margin-top: 24px; display: flex; gap: 12px;')
        button.btn.btn-primary(type='submit')
          span.glyphicon.glyphicon-ok(style='margin-right: 6px;')
          | #{t('easy_setup.apply_btn')}
        a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.cancel')
