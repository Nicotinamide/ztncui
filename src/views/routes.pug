//-
  ztncui - ZeroTier network controller UI
  Modern Routes View

extends network_layout

block net_content
  .modern-card
    .modern-card-header
      div
        h3= t('routes.title')
        p.modern-card-subtitle= t('routes.subtitle')

    if network.routes && network.routes.length > 0
      .table-responsive
        table.table.table-hover
          thead
            tr
              th(style='width: 5%;')
              th(style='width: 45%;')= t('routes.target')
              th(style='width: 50%;')= t('routes.gateway')
          tbody
            each route in network.routes
              tr
                td
                  a(href='/controller/network/' + network.nwid + '/routes/' + route.target + '/delete' title=t('common.delete') style='color: var(--danger);' onclick="return confirm('" + t('common.confirm') + " " + t('common.delete') + "?')")
                    span.glyphicon.glyphicon-trash
                td
                  span.badge-ip(style='font-size: 13px;')= route.target
                td
                  if route.via
                    span.badge-id= route.via
                  else
                    span(style='color: var(--text-muted); font-size: 13px;') (LAN Direct / 局域网直连)
    else
      .text-center(style='padding: 24px; background: #f8fafc; border-radius: 8px; margin-bottom: 20px;')
        p(style='color: var(--text-muted); margin: 0;')= t('routes.empty')

    .modern-card(style='background: #f8fafc; border: 1px solid var(--border); margin-top: 24px; margin-bottom: 0;')
      h4(style='font-size: 16px; font-weight: 700; margin-top: 0; margin-bottom: 16px;')= t('routes.add_btn')

      if errors
        .alert.alert-warning(style='border-radius: 8px;')
          ul(style='margin: 0; padding-left: 20px;')
            for err in errors
              li!= err.msg

      form(method='POST' action='/controller/network/' + network.nwid + '/routes')
        .row
          .col-sm-6
            .form-group
              label(for='target')= t('routes.target')
              input#target.form-control(type='text' name='target' placeholder=t('routes.target_placeholder') value=(undefined===route? '' : route.target) required)
          .col-sm-6
            .form-group
              label(for='via')= t('routes.gateway')
              input#via.form-control(type='text' name='via' placeholder=t('routes.gateway_placeholder') value=(undefined===route? '' : route.via))

        div(style='margin-top: 16px; display: flex; gap: 10px;')
          button.btn.btn-primary(type='submit')
            span.glyphicon.glyphicon-plus(style='margin-right: 4px;')
            | #{t('routes.add_btn')}
          a.btn.btn-default(href=('/controller/network/' + network.nwid))= t('common.cancel')
