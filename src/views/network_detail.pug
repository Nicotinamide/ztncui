//-
  ztncui - ZeroTier network controller UI
  Modern Network Detail & Member Management View

extends network_layout

block network_title
  div(style='display: flex; align-items: center; gap: 8px;')
    h2(style='margin: 0; font-size: 22px; font-weight: 700;')
      a#change-name(href='#' style='text-decoration: none; color: var(--text-main); display: inline-flex; align-items: center; gap: 6px;' title=t('common.edit'))
        span#name= network.name || 'Unnamed Network'
        i.glyphicon.glyphicon-pencil(style='font-size: 15px; color: var(--text-muted);')
      input#name-input.form-control(type='text' style='width: 220px; display: none; height: 36px; font-size: 16px;')

  script.
    $(function() {
      var nwurl = '/controller/network/#{network.nwid}';
      var name = !{JSON.stringify(network.name || '')};

      function toggleNameEditor(show) {
        $('#change-name').css('display', !show ? 'inline-flex' : 'none');
        $('#name-input').css('display', show ? 'inline-block' : 'none');
      }

      function submitName() {
        var newName = $('#name-input').val().trim();
        if (newName && newName !== name) {
          name = newName;
          $.post(nwurl + '/name', {'name': name})
            .done(function () {
              $('#name').text(newName);
              if (window.showToast) window.showToast('Network name updated');
            });
        }
        toggleNameEditor(false);
      }

      $('#change-name').on('click', function(e) {
        e.preventDefault();
        toggleNameEditor(true);
        $('#name-input').val(name).focus();
      });
      $('#name-input').on('blur', submitName);
      $('#name-input').keypress(function (e) {
        if (e.which === 13) submitName();
      });
    });

block net_content
  - const nwurl = '/controller/network/' + network.nwid;

  if (members !== undefined)
    .modern-card#members
      .modern-card-header
        div
          h3= t('network_detail.members_title') + ' (' + members.length + ')'
          p.modern-card-subtitle= t('network_detail.members_subtitle')
        div(style='min-width: 240px;')
          input#memberSearch.form-control(type='text' placeholder=t('network_detail.search_placeholder') onkeyup="filterTable('memberSearch', 'membersTable')")

      if members.length > 0
        .table-responsive
          table#membersTable.table.table-hover
            thead
              tr
                th(style='width: 4%; text-align: center;')
                th(style='width: 18%;')= t('network_detail.name_remark')
                th(style='width: 14%;')= t('network_detail.node_id')
                th(style='width: 8%; text-align: center;')= t('network_detail.auth')
                th(style='width: 8%; text-align: center;') Bridge
                th(style='width: 18%;')= t('network_detail.managed_ips')
                th(style='width: 14%;')= t('common.status')
                th(style='width: 16%;')= t('network_detail.physical_ip')
            tbody
              each member in members
                - const peer = member.peer;
                - const memberUrl = nwurl + '/member/' + member.id;
                tr
                  td(style='text-align: center;')
                    a(href=memberUrl + '/delete' title=t('common.delete') style='color: var(--danger);' onclick="return confirm('" + t('network_detail.delete_member_confirm') + "')")
                      span.glyphicon.glyphicon-trash
                  td
                    input.form-control.input-sm.member-name(type='text' name=member.id value=member.name placeholder=t('network_detail.name_remark') data-id=member.id)
                  td
                    div(style='display: flex; align-items: center; gap: 6px;')
                      a(href=memberUrl style='font-family: monospace; font-weight: 600; text-decoration: none; color: var(--primary);')
                        | #{member.id}
                      button.copy-btn(type='button' onclick="copyToClipboard('" + member.id + "', '" + t('common.copied') + "')" title=t('common.copy'))
                        span.glyphicon.glyphicon-copy
                  td(style='text-align: center;')
                    label.switch-box
                      input.authCheck(type='checkbox' value=member.id checked=(member.authorized ? true : false))
                      span.slider
                  td(style='text-align: center;')
                    label.switch-box
                      input.bridgeCheck(type='checkbox' value=member.id checked=(member.activeBridge ? true : false))
                      span.slider
                  td
                    if member.ipAssignments && member.ipAssignments.length > 0
                      each ip in member.ipAssignments
                        a.badge-ip(href=memberUrl + '/ipAssignments' title=t('common.edit'))
                          = ip
                    else
                      a.badge-ip(href=memberUrl + '/ipAssignments' style='background: #f1f5f9; color: var(--text-muted); border-color: #cbd5e1;')
                        | + #{t('network_detail.managed_ips')}
                  td
                    if (peer && peer.latency !== -1 && peer.versionMajor !== -1)
                      span(style='color: var(--success); font-weight: 600; display: inline-flex; align-items: center;')
                        span.badge-status-dot.dot-online
                        | ONLINE (v#{peer.version})
                    else if (member.id === zt_address)
                      span(style='color: var(--primary); font-weight: 600; display: inline-flex; align-items: center;')
                        span.badge-status-dot(style='background: var(--primary);')
                        | CONTROLLER
                    else
                      span(style='color: var(--text-muted); display: inline-flex; align-items: center;')
                        span.badge-status-dot.dot-offline
                        | OFFLINE
                  td
                    if (peer && peer.paths)
                      each path in peer.paths
                        if (path.preferred === true)
                          - const [ip, port] = path.address.split('/');
                          div(style='font-size: 12px; font-family: monospace;')
                            = ip
                            span(style='color: var(--text-muted);') :#{port}
                          if (peer.latency !== -1)
                            span.badge(style='background: #e2e8f0; color: #334155; font-size: 11px; margin-top: 2px;')
                              | ⚡ #{peer.latency} ms
                          - break
      else
        .text-center(style='padding: 36px 16px; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;')
          p(style='color: var(--text-muted); margin: 0;')= t('network_detail.no_members')

    script.
      $(function() {
        const url = "#{nwurl}/members";

        $('.authCheck').on('change', function() {
          const id = this.value;
          const auth = this.checked;
          $.post(url, {'id': id, 'auth': auth})
            .done(function() {
              if (window.showToast) window.showToast(auth ? 'Member Authorized' : 'Member Deauthorized');
            })
            .fail(function() {
              if (window.showToast) window.showToast('Failed to update authorization', 'error');
            });
        });

        $('.bridgeCheck').on('change', function() {
          const id = this.value;
          const activeBridge = this.checked;
          $.post(url, {'id': id, 'activeBridge': activeBridge})
            .done(function() {
              if (window.showToast) window.showToast('ActiveBridge updated');
            })
            .fail(function() {
              if (window.showToast) window.showToast('Failed to update bridge', 'error');
            });
        });

        $('.member-name').on('change', function() {
          const id = $(this).data('id');
          const name = $(this).val();
          $.post(url, {'id': id, 'name': name})
            .done(function() {
              if (window.showToast) window.showToast('Device name saved');
            })
            .fail(function() {
              if (window.showToast) window.showToast('Failed to save name', 'error');
            });
        });
      });

  //- Raw JSON collapsible developer section
  .modern-card(style='background: #f8fafc; border: 1px dashed #cbd5e1;')
    details
      summary(style='font-weight: 600; color: var(--text-muted); cursor: pointer; user-select: none;')
        | 🛠️ #{t('common.detail')}: Raw ZeroTier Network JSON
      div(style='margin-top: 16px;')
        each value, key in network
          .row(style='margin: 6px 0;')
            .col-sm-3
              strong= key
            .col-sm-9
              +json_value(value)
