//-
  ztncui - ZeroTier network controller UI
  Modern Users Layout

extends head_layout

block nav_items
  +nav_item('controller_home', t('nav.brand'), '/controller')
  +nav_item('networks', t('nav.networks'), '/controller/networks')
  +nav_item('users', t('nav.users'), '/users')
  +nav_item('create_user', t('users.add_user'), '/users/create')

block body_content
  .container(style='margin-top: 24px; margin-bottom: 40px;')
    .row
      .col-sm-12
        if error
          .alert.alert-danger(style='border-radius: 8px;')
            strong ❌ #{error}
        else
          block users_content
