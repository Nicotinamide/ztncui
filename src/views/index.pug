//-
  ztncui - ZeroTier network controller UI
  Modern Controller Home Dashboard

extends controller_layout

block content
  .modern-card
    .modern-card-header
      div
        h2= t('nav.brand')
        p.modern-card-subtitle ZeroTier One Network Controller Dashboard
      div
        a.btn.btn-primary(href='/controller/networks')
          span.glyphicon.glyphicon-th-list(style='margin-right: 6px;')
          | #{t('networks.title')}

    if error
      .alert.alert-danger(style='border-radius: 8px;')
        strong ❌ #{error}
    else
      .row(style='margin-top: 16px;')
        .col-sm-6
          .modern-card(style='background: #f8fafc; border: 1px solid #e2e8f0; margin-bottom: 16px;')
            h4(style='font-size: 14px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-top: 0;')
              | #{t('network_detail.node_id')} (Controller)
            div(style='display: flex; align-items: center; justify-content: space-between; margin-top: 10px;')
              span.badge-id(style='font-size: 18px; font-weight: 700; color: var(--primary);')
                | #{zt_status.address}
              button.btn.btn-default.btn-sm(type='button' onclick="copyToClipboard('" + zt_status.address + "', '" + t('common.copied') + "')")
                span.glyphicon.glyphicon-copy(style='margin-right: 4px;')
                | #{t('common.copy')}

        .col-sm-6
          .modern-card(style='background: #f8fafc; border: 1px solid #e2e8f0; margin-bottom: 16px;')
            h4(style='font-size: 14px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-top: 0;')
              | ZeroTier Daemon
            div(style='display: flex; align-items: center; justify-content: space-between; margin-top: 10px;')
              span
                span.badge-status-dot.dot-online
                strong(style='font-size: 15px; color: var(--text-main);') v#{zt_status.version} (Online)
              span.badge.badge-pill-mode.mode-public(style='font-size: 12px;')
                | #{zt_status.online ? t('common.online') : t('common.offline')}

      div(style='margin-top: 16px; display: flex; gap: 10px;')
        a.btn.btn-primary(href='/controller/networks')
          span.glyphicon.glyphicon-th-list(style='margin-right: 6px;')
          | #{t('networks.title')}
        a.btn.btn-default(href='/controller/network/create')
          span.glyphicon.glyphicon-plus(style='margin-right: 6px;')
          | #{t('networks.add_network')}
        a.btn.btn-default(href='/users')
          span.glyphicon.glyphicon-user(style='margin-right: 6px;')
          | #{t('nav.users')}
